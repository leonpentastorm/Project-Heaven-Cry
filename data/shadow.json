    {
      "id": "shadow.lift",
      "name": "Lift",
      "kind": "verb",
      "group": "work",
      "requires": [
        {
          "skill": "ingenuity",
          "min": 3
        }
      ],
      "adjudication": "engine",
      "provisional": true,
      "text": "{=effects.0.ap} AP: take a grenade or a spare magazine from an adjacent enemy into the pile on your tile. Unseen it isn't told; if it can see you, it makes a Body save against your Ingenuity.",
      "effects": [
        {
          "op": "grant_action",
          "action": "lift",
          "ap": 2,
          "uses": "at_will",
          "reach": {
            "tiles": 1,
            "side": "foe"
          },
          "effects": [
            {
              "op": "take",
              "target": "target",
              "if": {
                "target_sees_self": false
              },
              "say": "{self} lifts it unseen{then}."
            },
            {
              "op": "take",
              "target": "target",
              "save": "body",
              "via": "ingenuity",
              "if": {
                "target_sees_self": true
              },
              "say": "{self} tries a lift in plain sight{then}."
            }
          ]
        }
      ]
    },
    {
      "id": "shadow.fade",
