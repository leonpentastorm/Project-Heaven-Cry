      "adjudication": "engine",
      "provisional": true,
      "text": "{=effects.0.ap} AP and {=effects.0.res.shadow} Shadow: even while an enemy sees you, step to the nearest tile next to cover within one Move and become Hidden (a new entry: a fresh ambush). Not while Marked.",
      "effects": [
        {
          "op": "grant_action",
          "action": "fade",
          "ap": 2,
          "res": {
            "shadow": 2
          },
          "uses": "at_will",
          "if": {
            "self_lacks": [
              "marked",
              "hidden"
            ]
          },
          "effects": [
            {
              "op": "displace",
              "to": "cover",
              "say": "{self} fades into the shadows{then}."
            },
            {
              "op": "condition",
              "condition": "hidden",
              "skip_save": true
            }
          ],
          "why": {
            "self_lacks": "Not while Marked, or already Hidden."
          }
        }
      ]
    },
